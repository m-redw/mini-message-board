<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mini-Message-App</title>
  </head>
  <body>
    <% messages.forEach((message, index)=> {%>
        <p><%= message.user %></p>
        <p><%= message.text %></p>
        <p><%= message.date %></p>
        <a href="/messages/<%= index %>">Message details.</a>
    <% }) %>

    <a href="/new">Create a new message.</a>
  </body>
</html>
